# --- Meta / Instagram App (from developers.facebook.com) ---
IG_APP_ID=
IG_APP_SECRET=
# Must exactly match the redirect URI registered in the Meta App dashboard
IG_REDIRECT_URI=https://yourapp.vercel.app/api/auth/instagram/callback
# Random string you choose yourself — used to verify webhook setup calls from Meta
IG_WEBHOOK_VERIFY_TOKEN=choose-any-long-random-string

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Groq (AI fallback replies) ---
GROQ_API_KEY=
